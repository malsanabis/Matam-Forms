rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config (sections + users) — readable by anyone, writable by anyone
    // (since the app has its own admin password logic)
    match /config/{doc} {
      allow read, write: if true;
    }

    // Submissions — anyone can read/write
    match /submissions/{subId} {
      allow read, write: if true;
    }

    // Recycle bin — anyone can read/write
    match /recyclebin/{docId} {
      allow read, write: if true;
    }

    // Admin action logs — anyone can read/write
    match /logs/{logId} {
      allow read, write: if true;
    }

    // EmailJS and other secrets — anyone can read/write (app-level auth)
    match /secrets/{docId} {
      allow read, write: if true;
    }
  }
}
